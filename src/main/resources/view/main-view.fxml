<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ModalPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raiz"
           fx:controller="com.concretolab.controller.MainController"
           styleClass="app"
           prefWidth="1280.0" prefHeight="800.0">

    <fx:define>
        <ToggleGroup fx:id="menu"/>
    </fx:define>

    <BorderPane>
        <!-- ============ MENU LATERAL ============ -->
        <left>
            <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="248.0" minWidth="248.0">

                <HBox styleClass="marca" spacing="12.0">
                    <StackPane styleClass="marca-logo">
                        <FontIcon iconLiteral="fth-layers"/>
                    </StackPane>
                    <VBox fx:id="marcaTextos" spacing="1.0">
                        <Label text="ConcretoLab" styleClass="marca-titulo"/>
                        <Label text="Cálculo y ensayos" styleClass="marca-subtitulo"/>
                    </VBox>
                </HBox>

                <StackPane alignment="TOP_LEFT">
                    <Region fx:id="indicador" styleClass="nav-indicador"
                            prefHeight="42.0" maxHeight="-Infinity"/>
                    <VBox spacing="3.0">
                        
                        <Label text="GENERAL" styleClass="nav-seccion"/>
                        <ToggleButton fx:id="navInicio" text="Inicio" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-home"/></graphic>
                        </ToggleButton>

                        <Label text="PROYECTO" styleClass="nav-seccion"/>
                        <ToggleButton fx:id="navModelo" text="Modelo 3D y metrado" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-box"/></graphic>
                        </ToggleButton>

                        <Label text="ANÁLISIS ESTRUCTURAL" styleClass="nav-seccion"/>
                        <ToggleButton fx:id="navSismo" text="Análisis sísmico E.030" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-activity"/></graphic>
                        </ToggleButton>

                        <Label text="DISEÑO DE CONCRETO" styleClass="nav-seccion"/>
                        <ToggleButton fx:id="navMateriales" text="Materiales y ensayos" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-layers"/></graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="navGranulometria" text="Granulometría" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-bar-chart-2"/></graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="navBalance" text="Balance de volúmenes" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-sliders"/></graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="navMezclas" text="Mezclas y probetas" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-droplet"/></graphic>
                        </ToggleButton>

                        <Label text="SISTEMA" styleClass="nav-seccion"/>
                        <ToggleButton fx:id="navDatos" text="Datos y copias" toggleGroup="$menu"
                                      styleClass="nav-item" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-database"/></graphic>
                        </ToggleButton>
                    </VBox>
                </StackPane>

                <Region VBox.vgrow="ALWAYS"/>

                <Separator styleClass="nav-separador"/>
                <Button fx:id="btnTema" text="Modo oscuro" onAction="#onCambiarTema"
                        styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-moon"/></graphic>
                </Button>
                <Button fx:id="btnAcerca" text="Acerca de" onAction="#onAcercaDe"
                        styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-info"/></graphic>
                </Button>
                <Button fx:id="btnContraer" text="Contraer menu" onAction="#onContraerMenu"
                        styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-chevrons-left"/></graphic>
                </Button>
            </VBox>
        </left>

        <!-- ============ CONTENIDO ============ -->
        <center>
            <StackPane fx:id="contenido" styleClass="contenido"/>
        </center>
    </BorderPane>

    <!-- Capas flotantes: panel de formulario, dialogos y notificaciones -->
    <ModalPane fx:id="modalPanel"/>
    <ModalPane fx:id="modalDialogo"/>
    <VBox fx:id="zonaNotificaciones" styleClass="zona-notificaciones" spacing="10.0"
          pickOnBounds="false" alignment="BOTTOM_RIGHT" viewOrder="-100"
          StackPane.alignment="BOTTOM_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity"/>
</StackPane>
