<?xml version="1.0" encoding="utf-8"?>
<!-- Textos en español del instalador. jpackage (JDK 17) agrega este archivo desde src/main/jpackage y pone la cultura
     es-es primero, así que los diálogos estándar de WiX también salen en español. Los identificadores CL_ los usan las
     copias modificadas ShortcutPromptDlg.wxs e InstallDirNotEmptyDlg.wxs (no pueden repetir los de jpackage). -->
<WixLocalization Culture="es-es" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="1252">
  <String Id="CL_InstallDirExiste">La carpeta [INSTALLDIR] ya existe. ¿Desea instalar en esa carpeta de todos modos?</String>
  <String Id="CL_InstallDirNotEmptyDlg_Title">Instalación de [ProductName]</String>
  <String Id="CL_ShortcutPromptDlg_Title">Instalación de [ProductName]</String>
  <String Id="CL_ShortcutPromptDlgTitle">{\WixUI_Font_Title}Accesos directos</String>
  <String Id="CL_ShortcutPromptDlgDescription">El acceso del menú Inicio se crea siempre. ¿Quiere también uno en el escritorio?</String>
  <String Id="CL_EscritorioEtiqueta">Crear un acceso directo en el escritorio</String>
</WixLocalization>
