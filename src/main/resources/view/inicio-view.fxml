<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.concretolab.controller.InicioController"
            styleClass="pagina-scroll" fitToWidth="true" hbarPolicy="NEVER">
    <VBox styleClass="pagina" spacing="18.0">

        <HBox styleClass="pagina-cabecera" alignment="CENTER_LEFT">
            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                <Label text="Bienvenido a ConcretoLab" styleClass="pagina-titulo"/>
                <Label text="Organiza la información del proyecto, los materiales y las pruebas en un solo lugar."
                       styleClass="pagina-subtitulo" wrapText="true"/>
            </VBox>
        </HBox>

        <VBox styleClass="tarjeta" spacing="9.0">
            <Label text="¿Es su primera vez? Practique con un ejemplo" styleClass="seccion-form"/>
            <Label text="Agregue el proyecto «EJEMPLO · Edificio de práctica»: un edificio de 3 pisos listo para el análisis sísmico, una mezcla con sus probetas y materiales con su tamizado. Son datos ficticios y sus proyectos no se modifican."
                   styleClass="pagina-subtitulo" wrapText="true"/>
            <HBox spacing="8.0">
                <Button fx:id="btnAgregarEjemplo" text="Agregar proyecto de ejemplo" onAction="#onAgregarEjemplo" styleClass="accent">
                    <graphic><FontIcon iconLiteral="fth-plus-circle"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <VBox styleClass="tarjeta" spacing="9.0">
            <Label text="01   Proyecto y modelo" styleClass="seccion-form"/>
            <Label text="Cree un proyecto y represente sus elementos. Puede comenzar con una plantilla de cuatro zapatas, columnas y vigas."
                   styleClass="pagina-subtitulo" wrapText="true"/>
            <HBox><Button text="Abrir modelo" onAction="#onAbrirModelo" styleClass="accent"/></HBox>
        </VBox>

        <VBox styleClass="tarjeta" spacing="9.0">
            <Label text="02   Materiales y granulometría" styleClass="seccion-form"/>
            <Label text="Registre resultados reales del laboratorio y calcule los porcentajes del tamizado a partir de las masas medidas."
                   styleClass="pagina-subtitulo" wrapText="true"/>
            <HBox><Button text="Abrir materiales" onAction="#onAbrirMateriales" styleClass="accent"/></HBox>
        </VBox>

        <VBox styleClass="tarjeta" spacing="9.0">
            <Label text="03   Mezclas y pruebas" styleClass="seccion-form"/>
            <Label text="Registre una dosificación existente, corríjala por humedad y conserve los resultados de ensayos."
                   styleClass="pagina-subtitulo" wrapText="true"/>
            <HBox><Button text="Abrir mezclas" onAction="#onAbrirMezclas" styleClass="accent"/></HBox>
        </VBox>

        <VBox styleClass="tarjeta" spacing="9.0">
            <Label text="04   Análisis sísmico" styleClass="seccion-form"/>
            <Label text="Analiza el pórtico del proyecto según la E.030: modos, estático, modal espectral y derivas, con reporte PDF."
                   styleClass="pagina-subtitulo" wrapText="true"/>
            <HBox><Button text="Abrir análisis sísmico" onAction="#onAbrirSismo" styleClass="accent"/></HBox>
        </VBox>

    </VBox>
</ScrollPane>
