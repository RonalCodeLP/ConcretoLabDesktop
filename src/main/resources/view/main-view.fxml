<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ModalPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raiz"
           fx:controller="com.concretolab.controller.MainController"
           styleClass="app"
           prefWidth="1280.0" prefHeight="800.0">

    <BorderPane>
        <top>
            <MenuBar fx:id="barraMenu">
                <Menu text="_Archivo">
                    <MenuItem fx:id="mnuDatos" text="Datos y copias..." onAction="#onMenuDatos"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Salir" onAction="#onSalir"/>
                </Menu>
                <Menu text="_Ver">
                    <MenuItem text="Inicio" onAction="#onMenuInicio"/>
                    <SeparatorMenuItem/>
                    <CheckMenuItem fx:id="mnuOscuro" text="Modo oscuro" onAction="#onCambiarTema"/>
                </Menu>
                <Menu text="_Proyecto">
                    <MenuItem text="Modelo 3D y metrado" onAction="#onMenuModelo"/>
                </Menu>
                <Menu text="A_nálisis">
                    <MenuItem text="Análisis sísmico E.030" onAction="#onMenuSismo"/>
                </Menu>
                <Menu text="_Concreto">
                    <MenuItem text="Materiales y ensayos" onAction="#onMenuMateriales"/>
                    <MenuItem text="Granulometría" onAction="#onMenuGranulometria"/>
                    <MenuItem text="Balance de volúmenes" onAction="#onMenuBalance"/>
                    <MenuItem text="Mezclas y probetas" onAction="#onMenuMezclas"/>
                </Menu>
                <Menu fx:id="mnuAyuda" text="A_yuda">
                    <MenuItem text="Manual de usuario" onAction="#onManual"/>
                    <MenuItem text="Ayuda de esta pantalla" onAction="#onAyudaPantalla">
                        <accelerator><KeyCodeCombination code="F1" alt="UP" control="UP" meta="UP" shift="UP" shortcut="UP"/></accelerator>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Recorrido de bienvenida" onAction="#onBienvenida"/>
                    <MenuItem text="Agregar proyecto de ejemplo" onAction="#onEjemplo"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Acerca de ConcretoLab" onAction="#onAcercaDe"/>
                </Menu>
            </MenuBar>
        </top>

        <center>
            <TabPane fx:id="pestanas" styleClass="pestanas-principales" tabClosingPolicy="UNAVAILABLE">
                <Tab fx:id="tabInicio" text="Inicio"/>
                <Tab fx:id="tabModelo" text="Modelo 3D y metrado"/>
                <Tab fx:id="tabSismo" text="Análisis sísmico"/>
                <Tab fx:id="tabMateriales" text="Materiales"/>
                <Tab fx:id="tabGranulometria" text="Granulometría"/>
                <Tab fx:id="tabBalance" text="Balance"/>
                <Tab fx:id="tabMezclas" text="Mezclas y probetas"/>
                <Tab fx:id="tabDatos" text="Datos y copias"/>
            </TabPane>
        </center>

        <bottom>
            <HBox styleClass="barra-estado" spacing="0.0">
                <Label fx:id="lblMensaje" styleClass="estado-mensaje" text="Listo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblProyectoActivo" styleClass="estado-celda" text="Sin proyecto"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblVersion" styleClass="estado-celda"/>
            </HBox>
        </bottom>
    </BorderPane>

    <ModalPane fx:id="modalPanel"/>
    <ModalPane fx:id="modalDialogo"/>
</StackPane>
